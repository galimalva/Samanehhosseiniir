
---
import Layout from '../layouts/Layout.astro';
---

<Layout title="داستان‌ها - سمانه حسینی" active="stories">
  <style>
    .stories-page {
      max-width: 1100px;
      margin: 0 auto;
      padding: 40px 20px 70px;
      direction: rtl;
    }

    .stories-header {
      text-align: center;
      padding: 45px 20px;
      margin-bottom: 35px;
      background: linear-gradient(135deg, #064e3b, #047857, #10b981);
      border-radius: 16px;
      color: white;
    }

    .stories-header h1 {
      font-size: 34px;
      margin: 0 0 12px;
      color: white;
    }

    .stories-header p {
      font-size: 15px;
      line-height: 1.9;
      opacity: 0.9;
      margin: 0;
    }

    .stories-count {
      margin-bottom: 25px;
      color: #555;
      font-size: 15px;
    }

    .stories-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 25px;
    }

    .story-card {
      background: white;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 3px 15px rgba(0, 0, 0, 0.07);
      border: 1px solid #e5e7eb;
      transition: transform 0.3s, box-shadow 0.3s;
      display: flex;
      flex-direction: column;
    }

    .story-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 25px rgba(16, 185, 129, 0.15);
    }

    .story-image {
      width: 100%;
      height: 190px;
      object-fit: cover;
      display: block;
    }

    .story-placeholder {
      height: 190px;
      background: linear-gradient(135deg, #064e3b, #10b981);
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 60px;
      color: white;
    }

    .story-body {
      padding: 22px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .story-title {
      font-size: 20px;
      color: #064e3b;
      margin: 0 0 12px;
      line-height: 1.7;
    }

    .story-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      color: #888;
      font-size: 12px;
      margin-bottom: 15px;
    }

    .story-excerpt {
      color: #666;
      font-size: 14px;
      line-height: 2;
      margin: 0 0 20px;
      flex: 1;
      white-space: pre-line;
      overflow-wrap: anywhere;
    }

    .story-link {
      display: inline-block;
      text-align: center;
      padding: 12px 20px;
      background: #059669;
      color: white;
      text-decoration: none;
      border-radius: 8px;
      font-size: 14px;
      transition: background 0.3s;
    }

    .story-link:hover {
      background: #047857;
    }

    .age-badge {
      color: #991b1b;
      background: #fee2e2;
      border-radius: 5px;
      padding: 2px 8px;
    }

    .loading,
    .empty,
    .error-message {
      text-align: center;
      padding: 65px 20px;
      background: white;
      border-radius: 14px;
      color: #777;
      font-size: 15px;
      line-height: 2;
    }

    .error-message {
      color: #b91c1c;
    }

    .retry-button {
      background: #059669;
      color: white;
      border: none;
      padding: 10px 22px;
      border-radius: 8px;
      cursor: pointer;
      font-family: inherit;
      margin-top: 15px;
    }

    @media (max-width: 600px) {
      .stories-page {
        padding: 20px 15px 40px;
      }

      .stories-header {
        padding: 30px 15px;
      }

      .stories-header h1 {
        font-size: 26px;
      }

      .stories-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <main class="stories-page">
    <header class="stories-header">
      <h1>📖 داستان‌ها</h1>
      <p>
        مجموعه‌ای از داستان‌های کوتاه سمانه حسینی
      </p>
    </header>

    <div id="storiesCount" class="stories-count"></div>

    <div id="storiesContainer">
      <div class="loading">
        در حال بارگذاری داستان‌ها...
      </div>
    </div>
  </main>

  <script>
    import { supabase } from '../lib/supabase.js';

    const container = document.getElementById('storiesContainer');
    const countElement = document.getElementById('storiesCount');

    function escapeHtml(value) {
      if (value == null) return '';

      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function formatDate(dateValue) {
      if (!dateValue) return '';

      const date = new Date(dateValue);

      if (Number.isNaN(date.getTime())) {
        return '';
      }

      return date.toLocaleDateString('fa-IR');
    }

    function getExcerpt(story) {
      const text = story.excerpt || story.content || '';

      if (text.length > 170) {
        return text.substring(0, 170) + '...';
      }

      return text;
    }

    function createStoryCard(story) {
      const title = escapeHtml(story.title || 'بدون عنوان');
      const author = escapeHtml(story.author || 'سمانه حسینی');
      const excerpt = escapeHtml(getExcerpt(story));
      const date = formatDate(story.created_at);

      const storyUrl = '/stories/' +
        encodeURIComponent(story.slug);

      const image = story.image_url
        ? `
          <img
            class="story-image"
            src="${escapeHtml(story.image_url)}"
            alt="${title}"
            loading="lazy"
          />
        `
        : `
          <div class="story-placeholder">
            📖
          </div>
        `;

      const ageRating = story.age_rating
        ? `
          <span class="age-badge">
            ${escapeHtml(story.age_rating)}
          </span>
        `
        : '';

      return `
        <article class="story-card">
          ${image}

          <div class="story-body">
            <h2 class="story-title">
              ${title}
            </h2>

            <div class="story-meta">
              <span>✍️ ${author}</span>

              ${date
                ? `<span>📅 ${date}</span>`
                : ''
              }

              ${ageRating}
            </div>

            <p class="story-excerpt">
              ${excerpt}
            </p>

            <a
              href="${storyUrl}"
              class="story-link"
            >
              خواندن داستان ←
            </a>
          </div>
        </article>
      `;
    }

    async function loadStories() {
      if (!container) return;

      container.innerHTML = `
        <div class="loading">
          در حال بارگذاری داستان‌ها...
        </div>
      `;

      try {
        const { data, error } = await supabase
          .from('stories')
          .select('*')
          .order('created_at', { ascending: false });

        if (error) {
          throw error;
        }

        const stories = data || [];

        if (countElement) {
          countElement.textContent =
            `تعداد داستان‌ها: ${stories.length}`;
        }

        if (stories.length === 0) {
          container.innerHTML = `
            <div class="empty">
              <div style="font-size:45px">📖</div>
              <h3>هنوز داستانی منتشر نشده است.</h3>
              <p>داستان‌های جدید به‌زودی اضافه خواهند شد.</p>
            </div>
          `;
          return;
        }

        container.innerHTML = `
          <div class="stories-grid">
            ${stories.map(createStoryCard).join('')}
          </div>
        `;

      } catch (error) {
        console.error('Error loading stories:', error);

        if (countElement) {
          countElement.textContent = '';
        }

        container.innerHTML = `
          <div class="error-message">
            <h3>خطا در بارگذاری داستان‌ها</h3>
            <p>
              ارتباط با پایگاه داده برقرار نشد
              یا دسترسی به داستان‌ها مجاز نیست.
            </p>
            <button
              id="retryStories"
              class="retry-button"
              type="button"
            >
              تلاش دوباره
            </button>
          </div>
        `;

        document.getElementById('retryStories')
          ?.addEventListener('click', loadStories);
      }
    }

    loadStories();
  </script>
</Layout>
