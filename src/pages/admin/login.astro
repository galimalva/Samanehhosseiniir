
---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="ورود به پنل مدیریت" active="">
  <style>
    .login-page {
      min-height: calc(100vh - 130px);
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #064e3b, #047857, #10b981);
      padding: 20px;
      direction: rtl;
    }

    .login-box {
      background: white;
      padding: 40px;
      border-radius: 16px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      width: 100%;
      max-width: 380px;
      box-sizing: border-box;
    }

    .login-box h2 {
      text-align: center;
      margin: 0 0 30px;
      color: #064e3b;
      font-size: 24px;
    }

    .input-group {
      margin-bottom: 20px;
    }

    .input-group label {
      display: block;
      margin-bottom: 8px;
      color: #555;
      font-size: 14px;
    }

    .input-group input {
      width: 100%;
      padding: 14px;
      border: 2px solid #ddd;
      border-radius: 10px;
      font-size: 14px;
      font-family: Tahoma, sans-serif;
      transition: border-color 0.3s;
      box-sizing: border-box;
      direction: ltr;
      text-align: left;
    }

    .input-group input:focus {
      border-color: #10b981;
      outline: none;
    }

    .login-btn {
      width: 100%;
      padding: 14px;
      background: linear-gradient(135deg, #064e3b, #10b981);
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 16px;
      cursor: pointer;
      font-family: Tahoma, sans-serif;
      margin-top: 10px;
      transition: all 0.3s;
    }

    .login-btn:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(16, 185, 129, 0.4);
    }

    .login-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }

    .error {
      color: #b91c1c;
      text-align: center;
      margin-top: 15px;
      font-size: 14px;
      background: #fee2e2;
      padding: 12px;
      border-radius: 8px;
    }

    .success {
      color: #047857;
      text-align: center;
      margin-top: 15px;
      font-size: 14px;
    }

    .back-home {
      text-align: center;
      margin-top: 25px;
    }

    .back-home a {
      color: #047857;
      text-decoration: none;
      font-size: 13px;
    }

    .back-home a:hover {
      text-decoration: underline;
    }

    [hidden] {
      display: none !important;
    }

    @media (max-width: 480px) {
      .login-box {
        padding: 25px 20px;
      }

      .login-box h2 {
        font-size: 20px;
      }
    }
  </style>

  <div class="login-page">
    <div class="login-box">
      <h2>🔐 ورود به پنل مدیریت</h2>

      <form id="loginForm">
        <div class="input-group">
          <label for="email">ایمیل</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="ایمیل مدیر"
            required
            autocomplete="email"
          />
        </div>

        <div class="input-group">
          <label for="password">رمز عبور</label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="رمز عبور"
            required
            autocomplete="current-password"
          />
        </div>

        <button
          type="submit"
          id="submitBtn"
          class="login-btn"
        >
          ورود
        </button>

        <p
          class="error"
          id="errorMsg"
          role="alert"
          hidden
        ></p>

        <p
          class="success"
          id="successMsg"
          role="status"
          hidden
        ></p>
      </form>

      <div class="back-home">
        <a href="/">← بازگشت به سایت</a>
      </div>
    </div>
  </div>

  <script>
    import { supabase } from '../../lib/supabase.js';

    const form = document.getElementById('loginForm');
    const submitBtn = document.getElementById('submitBtn');
    const errorMsg = document.getElementById('errorMsg');
    const successMsg = document.getElementById('successMsg');
    const emailInput = document.getElementById('email');
    const passwordInput = document.getElementById('password');

    const dashboardUrl = '/admin/dashboard';

    function showError(message) {
      if (!errorMsg || !successMsg) return;

      errorMsg.textContent = message;
      errorMsg.hidden = false;
      successMsg.hidden = true;
    }

    function showSuccess(message) {
      if (!errorMsg || !successMsg) return;

      successMsg.textContent = message;
      successMsg.hidden = false;
      errorMsg.hidden = true;
    }

    function setLoading(loading) {
      if (!submitBtn) return;

      submitBtn.disabled = loading;
      submitBtn.textContent = loading
        ? 'در حال ورود...'
        : 'ورود';
    }

    async function checkExistingSession() {
      try {
        const { data, error } = await supabase.auth.getSession();

        if (error) {
          console.error('Session check error:', error);
          return;
        }

        if (data.session) {
          window.location.replace(dashboardUrl);
        }
      } catch (error) {
        console.error('Session check failed:', error);
      }
    }

    async function handleLogin(event) {
      event.preventDefault();

      if (!emailInput || !passwordInput) return;

      const email = emailInput.value.trim();
      const password = passwordInput.value;

      if (!email || !password) {
        showError('لطفاً ایمیل و رمز عبور را وارد کنید.');
        return;
      }

      if (errorMsg) errorMsg.hidden = true;

      showSuccess('در حال بررسی اطلاعات...');
      setLoading(true);

      try {
        const { data, error } =
          await supabase.auth.signInWithPassword({
            email,
            password
          });

        if (error) {
          console.error('Login error:', error);

          if (error.message === 'Invalid login credentials') {
            showError('ایمیل یا رمز عبور اشتباه است.');
          } else if (error.message === 'Email not confirmed') {
            showError('ایمیل شما هنوز تأیید نشده است.');
          } else {
            showError('ورود انجام نشد. لطفاً دوباره تلاش کنید.');
          }

          return;
        }

        if (!data.session) {
          showError('نشست ورود ایجاد نشد. دوباره تلاش کنید.');
          return;
        }

        showSuccess('ورود موفق! در حال انتقال به داشبورد...');

        window.location.replace(dashboardUrl);

      } catch (error) {
        console.error('Unexpected login error:', error);

        showError(
          'خطا در ارتباط با سرور. اتصال اینترنت را بررسی کنید.'
        );
      } finally {
        setLoading(false);
      }
    }

    form?.addEventListener('submit', handleLogin);

    checkExistingSession();
  </script>
</Layout>
