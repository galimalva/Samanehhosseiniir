---
import Layout from '../layouts/Layout.astro'
---
<Layout title="سمانه حسینی" active="home">
    <style>
        .hero {
            background: linear-gradient(135deg, #f0f9f3 0%, #e3f5ec 50%, #d4ecde 100%);
            padding: 100px 20px 80px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        .hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(16, 185, 129, 0.15), transparent);
            border-radius: 50%;
            z-index: 0;
        }
        .hero::after {
            content: '';
            position: absolute;
            bottom: -50%;
            left: -20%;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(5, 150, 105, 0.15), transparent);
            border-radius: 50%;
            z-index: 0;
        }
        .hero-content { position: relative; z-index: 1; max-width: 800px; margin: 0 auto; }
        .portrait-wrapper { position: relative; width: 380px; height: 380px; margin: 0 auto 40px; }
        .portrait-wrapper::before {
            content: '';
            position: absolute;
            inset: -20px;
            background: linear-gradient(135deg, #10b981, #059669);
            border-radius: 50%;
            z-index: 0;
            opacity: 0.3;
            filter: blur(30px);
        }
        .portrait-wrapper::after {
            content: '';
            position: absolute;
            inset: -8px;
            background: linear-gradient(135deg, #10b981, #059669);
            border-radius: 50%;
            z-index: 1;
        }
        .portrait {
            position: relative;
            width: 380px;
            height: 380px;
            border-radius: 50%;
            overflow: hidden;
            z-index: 2;
            border: 8px solid white;
            box-shadow: 0 25px 60px rgba(0,0,0,0.3);
            background: linear-gradient(135deg, #10b981, #059669);
        }
        .portrait img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .author-name-fa {
            font-size: 48px;
            color: #064e3b;
            font-weight: bold;
            margin-bottom: 8px;
            letter-spacing: 2px;
            text-shadow: 0 2px 4px rgba(255,255,255,0.5);
        }
        .author-name-en {
            font-size: 20px;
            color: #10b981;
            letter-spacing: 6px;
            direction: ltr;
            margin-bottom: 25px;
            font-weight: 300;
        }
        .divider {
            width: 80px;
            height: 3px;
            background: linear-gradient(90deg, transparent, #10b981, transparent);
            margin: 0 auto 25px;
        }
        .author-tagline {
            font-size: 17px;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            line-height: 2;
            font-style: italic;
        }
        @media (max-width: 500px) {
            .portrait-wrapper, .portrait { width: 280px; height: 280px; }
            .author-name-fa { font-size: 36px; }
            .author-name-en { font-size: 16px; }
        }
    </style>
    <section class="hero">
        <div class="hero-content">
            <div class="portrait-wrapper">
                <div class="portrait">
                    <img src="/images/author.jpg" alt="سمانه حسینی" onerror="this.style.display='none'">
                </div>
            </div>
            <h1 class="author-name-fa">سمانه حسینی</h1>
            <div class="author-name-en">SAMANEH HOSSEINI</div>
            <div class="divider"></div>
            <p class="author-tagline">
                نویسنده و روایت‌پرداز معاصر<br>
                داستان‌هایی از دل، دلنوشته‌هایی از جان
            </p>
        </div>
    </section>
</Layout>